<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Permisos obligatorios de la Etapa 0 ─────────────────────────────
         INTERNET: la etapa 0 transmite un audio de prueba por URL.
         FOREGROUND_SERVICE_MEDIA_PLAYBACK: exige Android 14+ para el servicio de audio.
         POST_NOTIFICATIONS: se pide en runtime en Android 13+ (MainActivity).
         WAKE_LOCK: para mantener la CPU despierta mientras suena.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- El ecualizador engancha el efecto de audio de la sesión del reproductor. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Etapa 3: el servicio de descargas es de tipo dataSync (bajar archivos). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Permite pedirle al sistema, con diálogo del usuario, poner la app "Sin restricciones" de batería.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ── Etapa 1: leer música del dispositivo y la microSD ────────────────
         Android 13+: permiso de AUDIO específico (no el de imágenes/video).
         Android 12 y anteriores: lectura de almacenamiento clásica.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".ResonarApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Resonar">

        <!-- Pantalla principal con Compose. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Servicio de reproducción ─────────────────────────────────────
             foregroundServiceType="mediaPlayback": obligatorio desde Android 14 para
             que el sistema permita un servicio en primer plano de audio.
             El intent-filter con la acción de MediaSessionService permite que el
             sistema (notificación, auriculares, asistente) reconecte y reanude.
        -->
        <service
            android:name=".player.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Receptor de botones multimedia (auriculares/bluetooth):
             es lo que permite reanudar la reproducción con el botón físico
             después de que el sistema mató el proceso. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- ── Servicio de descargas (Etapa 3) ──────────────────────────────
             foregroundServiceType="dataSync": así el sistema sabe que baja
             archivos. Con su notificación de progreso en primer plano, la
             descarga sigue aunque el usuario salga de la app. -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
